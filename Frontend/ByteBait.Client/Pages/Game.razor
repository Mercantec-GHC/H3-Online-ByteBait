@* A change of level creates a fresh canvas, USB receiver and pending-cast lifetime.
   Needs login, because the casts are saved on the player (S2.14). *@
@page "/game"
@attribute [Authorize]
@using System.Globalization

<PageTitle>Casting meter | ByteBait</PageTitle>

<main class="game-page">
    <div class="game-content">
        <header class="game-header">
            <h1>Casting meter</h1>
            <a href="/">Back to home</a>
        </header>

        @if (invalidLevel)
        {
            <p role="alert">Invalid level link. Open a level with a positive numeric ID.</p>
        }
        else
        {
            <p>@(levelId is null ? "Practice mode" : $"Level {levelId}")</p>
            <FishingSession @key="levelId" LevelId="levelId" />
        }
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "levelId")] private string[]? LevelValues { get; set; }
    private int? levelId;
    private bool invalidLevel;

    protected override void OnParametersSet()
    {
        levelId = null;
        invalidLevel = false;
        if (LevelValues is not { Length: > 0 }) return;
        if (LevelValues is [var value] && int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var id) && id > 0)
        {
            levelId = id;
        }
        else
        {
            invalidLevel = true;
        }
    }
}
