@* The username and password form shared by the login and register pages. Shows the API's errors under each field. *@

<EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="@SubmitText" class="account-form">
    <DataAnnotationsValidator />

    @if (error is not null)
    {
        <p class="account-error" role="alert">@error.Message</p>
    }

    <label for="userName">Username</label>
    <InputText id="userName" @bind-Value="form.UserName" autocomplete="username" />
    <ValidationMessage For="() => form.UserName" />
    <ApiFieldErrors Error="error" Field="userName" />

    <label for="password">Password</label>
    <InputText id="password" type="password" @bind-Value="form.Password" autocomplete="@PasswordAutocomplete" />
    <ValidationMessage For="() => form.Password" />
    <ApiFieldErrors Error="error" Field="password" />

    <button type="submit" disabled="@sending">@(sending ? "Please wait…" : SubmitText)</button>
</EditForm>

@code {
    [Parameter, EditorRequired] public string SubmitText { get; set; } = "";

    // "current-password" on login, "new-password" on register, so password managers fill in the right one
    [Parameter, EditorRequired] public string PasswordAutocomplete { get; set; } = "";

    // Returns null when it worked
    [Parameter, EditorRequired] public Func<AccountForm, Task<ApiError?>> OnSubmit { get; set; } = null!;

    [Parameter] public EventCallback OnSucceeded { get; set; }

    private readonly AccountForm form = new();
    private ApiError? error;
    private bool sending;

    private async Task SubmitAsync()
    {
        sending = true;
        error = null;
        try
        {
            error = await OnSubmit(form);
        }
        finally
        {
            sending = false;
        }

        if (error is null)
        {
            await OnSucceeded.InvokeAsync();
        }
    }
}
